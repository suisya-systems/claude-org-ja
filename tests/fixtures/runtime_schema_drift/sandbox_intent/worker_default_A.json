{
  "description": "worker_roles.default × Pattern A (independent project clone). Worker_dir = `<workers_dir>/<project_slug>/`, no base_clone supplied (Pattern A is supposed to be self-contained). additionalDirectories adds the knowledge/raw carve-out at {claude_org_path}/knowledge/raw (full-mode only by convention; Layer 4 hook permits raw notes). Home-anchored credential entries (~/.aws/** / ~/.ssh/**) escape read_roots and are suppressed (~/.config/gh/hosts.yml is NOT among them — it is carved out of every worker role at both layers per worker_roles.$comment_gh_credentials_carveout, Refs #429); worker_dir-anchored credential entries resolve under read_roots and are kept. Pins per docs/contracts/role-pattern-sandbox-contract.md §4.1.",
  "inputs": {
    "role": "default",
    "role_kind": "worker",
    "worker_dir": "/home/u/workers/proj",
    "claude_org_path": "/home/u/co",
    "pattern": "A",
    "home_dir": "/H",
    "wsl_detected": false,
    "realpath_map": [],
    "schema_source": "shipped"
  },
  "expected_explain": {
    "enabled": true,
    "wsl_detected": false,
    "sandbox_read_roots": [
      "/home/u/workers/proj",
      "/home/u/co/knowledge/raw"
    ],
    "suppressions": [
      {
        "layer": "sandbox.filesystem.denyRead",
        "entry": {
          "anchor": "home",
          "path": ".aws/**",
          "suppressOnSymlinkEscape": true,
          "layer2Fallback": "Read(~/.aws/*)"
        },
        "reason": "realpath escapes sandbox read roots",
        "realpath": "/H/.aws",
        "sandbox_read_roots": [
          "/home/u/workers/proj",
          "/home/u/co/knowledge/raw"
        ]
      },
      {
        "layer": "sandbox.filesystem.denyRead",
        "entry": {
          "anchor": "home",
          "path": ".ssh/**",
          "suppressOnSymlinkEscape": true,
          "layer2Fallback": "Read(~/.ssh/*)"
        },
        "reason": "realpath escapes sandbox read roots",
        "realpath": "/H/.ssh",
        "sandbox_read_roots": [
          "/home/u/workers/proj",
          "/home/u/co/knowledge/raw"
        ]
      }
    ],
    "rewrites": []
  },
  "expected_rendered_sandbox": {
    "enabled": true,
    "filesystem": {
      "additionalDirectories": [
        "/home/u/co/knowledge/raw"
      ],
      "allowRead": [
        ".env.example",
        ".env.*.example",
        "**/.env.example",
        "**/.env.*.example"
      ],
      "denyRead": [
        "/home/u/workers/proj/.env",
        "/home/u/workers/proj/**/.env",
        "/home/u/workers/proj/.env.*",
        "/home/u/workers/proj/**/.env.*",
        "/home/u/workers/proj/**/credentials*",
        "/home/u/workers/proj/**/*.pem"
      ],
      "denyWrite": []
    },
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "chatgpt.com",
        "*.chatgpt.com",
        "developers.openai.com",
        "api.openai.com",
        "auth.openai.com",
        "*.oaiusercontent.com"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_ENTERPRISE_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker build *",
      "docker buildx build *",
      "docker images *",
      "docker image inspect *"
    ]
  }
}
