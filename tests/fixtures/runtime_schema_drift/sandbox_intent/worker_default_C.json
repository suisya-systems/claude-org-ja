{
  "description": "worker_roles.default × Pattern C (ephemeral or gitignored_repo_root sub-mode). Worker_dir = `<workers_dir>/<task_id>/` (ephemeral) or `<existing_repo_root>/` (gitignored sub-mode). No base_clone; the sub-mode-specific worker_dir is captured at dispatch time via --worker-dir. additionalDirectories adds the knowledge/raw carve-out at {claude_org_path}/knowledge/raw (per §5.1). Pins per docs/contracts/role-pattern-sandbox-contract.md §4.3.",
  "inputs": {
    "role": "default",
    "role_kind": "worker",
    "worker_dir": "/home/u/workers/T123",
    "claude_org_path": "/home/u/co",
    "pattern": "C",
    "home_dir": "/H",
    "wsl_detected": false,
    "realpath_map": [],
    "schema_source": "shipped"
  },
  "expected_explain": {
    "enabled": true,
    "wsl_detected": false,
    "sandbox_read_roots": [
      "/home/u/workers/T123",
      "/home/u/co/knowledge/raw"
    ],
    "suppressions": [
      {
        "layer": "sandbox.filesystem.denyRead",
        "entry": {
          "anchor": "home",
          "path": ".aws/**",
          "suppressOnSymlinkEscape": true,
          "layer2Fallback": "Read(~/.aws/*)"
        },
        "reason": "realpath escapes sandbox read roots",
        "realpath": "/H/.aws",
        "sandbox_read_roots": [
          "/home/u/workers/T123",
          "/home/u/co/knowledge/raw"
        ]
      },
      {
        "layer": "sandbox.filesystem.denyRead",
        "entry": {
          "anchor": "home",
          "path": ".ssh/**",
          "suppressOnSymlinkEscape": true,
          "layer2Fallback": "Read(~/.ssh/*)"
        },
        "reason": "realpath escapes sandbox read roots",
        "realpath": "/H/.ssh",
        "sandbox_read_roots": [
          "/home/u/workers/T123",
          "/home/u/co/knowledge/raw"
        ]
      }
    ],
    "rewrites": []
  },
  "expected_rendered_sandbox": {
    "enabled": true,
    "filesystem": {
      "additionalDirectories": [
        "/home/u/co/knowledge/raw"
      ],
      "allowRead": [
        ".env.example",
        ".env.*.example",
        "**/.env.example",
        "**/.env.*.example"
      ],
      "denyRead": [
        "/home/u/workers/T123/.env",
        "/home/u/workers/T123/**/.env",
        "/home/u/workers/T123/.env.*",
        "/home/u/workers/T123/**/.env.*",
        "/home/u/workers/T123/**/credentials*",
        "/home/u/workers/T123/**/*.pem"
      ],
      "denyWrite": []
    },
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "chatgpt.com",
        "*.chatgpt.com",
        "developers.openai.com",
        "api.openai.com",
        "*.oaiusercontent.com"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_ENTERPRISE_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker build *",
      "docker buildx build *",
      "docker images *",
      "docker image inspect *"
    ]
  }
}
